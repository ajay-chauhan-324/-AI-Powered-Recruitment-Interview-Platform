NODE_ENV=development
PORT=4000

# Must match the origin the client dev server runs on (Vite default: 5173)
CLIENT_ORIGIN=http://localhost:5173

# Must point at a replica set — MongoDB Atlas (a replica set by default) or a
# local replica-set instance. A standalone mongod does NOT support the
# transactions this project's conflict-safe booking relies on (CLAUDE.md §13).
# See README.md "Local MongoDB" for how to run a project-dedicated local
# instance without touching any other MongoDB install on this machine.
MONGODB_URI=mongodb://127.0.0.1:27018/booking_system?replicaSet=rs0

# Number of reverse-proxy hops in front of this server (controls Express's `trust proxy`,
# which affects req.ip / rate-limiting correctness). 0 (default) is correct for local dev
# and direct exposure. Set to the real hop count in production (e.g. 1 behind a single
# load balancer/nginx) — trusting a hop that isn't actually there lets a client spoof
# X-Forwarded-For to bypass rate limiting.
TRUST_PROXY_HOPS=0

# Signs the admin session cookie (Phase 9) — must be at least 32 characters.
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Phase 7 (AI conversation layer). Server-side only (CLAUDE.md §16/§17: never sent to the
# client). Without OPENROUTER_API_KEY, the /api/v1/ai and /api/v1/admin/ai routes respond
# 503 rather than the whole server failing to boot — the same credential-free-default
# pattern used for SMTP above. Get a key at https://openrouter.ai/settings/keys.
AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# A free-tier model with tool-calling support; swap without a code change if this ever
# gets deprecated — see server/src/config/env.ts for how this is validated.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional (Phase 10). Without these, notifications (confirmation/reschedule/
# cancellation email) log their full content to the console instead of sending
# real email — a deliberate credential-free default, not a missing feature.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
