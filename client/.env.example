# Optional. Leave unset for local dev (Vite's proxy in vite.config.ts forwards /api to the
# server) or for a same-origin production deployment. Set this only when the client is
# deployed separately from the server (e.g. this client on Vercel, the server on Render) —
# the deployed backend's origin, no trailing slash, no /api/v1 suffix.
# VITE_API_URL=https://your-api.onrender.com
